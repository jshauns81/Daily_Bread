{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/family/**",
              "components/sheets/**",
              "ui_kits/kid_app/**",
              "ui_kits/mac_app/**",
              "ui_kits/parent_app/**",
              "ui_kits/widgets/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AchievementCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|name|description|points|rarity|earned|progress|target|style|key|ref|className|style|children)$/]",
        "message": "<AchievementCard> doesn't accept that prop. Declared props: icon, name, description, points, rarity, earned, progress, target, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AchievementCard'] > JSXAttribute[name.name='rarity'] > Literal[value!=/^(?:common|uncommon|rare|epic|legendary)$/]",
        "message": "<AchievementCard> rarity must be one of 'common' | 'uncommon' | 'rare' | 'epic' | 'legendary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AchievementDefRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|name|rarity|points|condition|enabled|onToggle|style|key|ref|className|style|children)$/]",
        "message": "<AchievementDefRow> doesn't accept that prop. Declared props: icon, name, rarity, points, condition, enabled, onToggle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AchievementDefRow'] > JSXAttribute[name.name='rarity'] > Literal[value!=/^(?:common|uncommon|rare|epic|legendary)$/]",
        "message": "<AchievementDefRow> rarity must be one of 'common' | 'uncommon' | 'rare' | 'epic' | 'legendary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApprovalRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:choreName|childName|value|approved|busy|onApprove|style|key|ref|className|style|children)$/]",
        "message": "<ApprovalRow> doesn't accept that prop. Declared props: choreName, childName, value, approved, busy, onApprove, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AtRiskItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|detail|urgency|money|minutes|key|ref|className|style|children)$/]",
        "message": "<AtRiskItem> doesn't accept that prop. Declared props: name, detail, urgency, money, minutes."
